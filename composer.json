{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "amadeus4dev/amadeus-php": "^0.3",
        "bensampo/laravel-enum": "^6.14",
        "guzzlehttp/guzzle": "^7.5",
        "inertiajs/inertia-laravel": "^2.0",
        "ippanel/php-rest-sdk": "^2.0",
        "laravel/fortify": "^1.15",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.0",
        "laravel/socialite": "^5.6",
        "laravel/tinker": "^3.0",
        "league/flysystem-google-cloud-storage": "^3.0",
        "livewire/livewire": "^3.4",
        "matchish/laravel-scout-elasticsearch": "^7.14",
        "pusher/pusher-php-server": "^7.2",
        "santigarcor/laratrust": "^8.5",
        "shetabit/payment": "^6.4",
        "spatie/laravel-google-cloud-storage": "^2.4",
        "spatie/laravel-medialibrary": "^11.0",
        "stripe/stripe-php": "^13.1",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "ext-http": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.23",
        "mockery/mockery": "^1.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
