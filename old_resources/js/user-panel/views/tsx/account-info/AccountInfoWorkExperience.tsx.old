    function createData(
        CompanyName: string,
        Position: string,
        date: string,
        Status: string,
        Update: React.ReactNode,
        Remove: React.ReactNode
    ) {
        return { date, Position, CompanyName, Status, Update, Remove };
    }

    const backgroundColors = (status) => {
      let backgroundColor = "";
      if (status === "Completed") backgroundColor = "primary.30";
      else if (status === "In Progress") backgroundColor = "primary.20";
      else backgroundColor = "orange.30";
      return backgroundColor;
  };

  const removeIconDisable = (status) => {
      if (status !== "In Progress") return true;
  };

