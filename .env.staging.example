# Copy to .env.staging, chmod 600, and replace every placeholder.
APP_NAME=LandaTrip Staging
APP_ENV=staging
APP_DEBUG=false
INERTIA_SSR_ENABLED=false
APP_URL=https://staging.example.invalid
APP_KEY=REPLACE_WITH_php_artisan_key_generate_show
STAGING_DOMAIN=staging.example.invalid
STAGING_HTTP_BIND=0.0.0.0:80
STAGING_HTTPS_BIND=0.0.0.0:443
STAGING_ACCESS_USER=staging
STAGING_ACCESS_PASSWORD_HASH=REPLACE_WITH_caddy_hash_password
STAGING_DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
STAGING_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=landatrip_staging
DB_USERNAME=landatrip_staging
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
MAIL_MAILER=log
SCOUT_DRIVER=null
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
TEST_ENABLED=false
BOOKING_TEST_CHECKOUT_ENABLED=false
BOOKING_TEST_GATEWAY=
TRUSTED_PROXIES=*
CORS_ALLOWED_ORIGINS=https://staging.example.invalid
SANCTUM_STATEFUL_DOMAINS=staging.example.invalid
VITE_APP_URL=https://staging.example.invalid
VITE_ASSET_URL=https://staging.example.invalid
