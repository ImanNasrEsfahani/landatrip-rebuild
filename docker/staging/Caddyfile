{$STAGING_DOMAIN} {
    encode zstd gzip
    basic_auth {
        {$STAGING_ACCESS_USER} {$STAGING_ACCESS_PASSWORD_HASH}
    }
    reverse_proxy web:8080 {
        header_up X-Forwarded-Proto https
        header_up Authorization {http.request.header.X-Staging-Api-Authorization}
        header_up -X-Staging-Api-Authorization
    }
    header Strict-Transport-Security "max-age=31536000"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
}
