import * as React from "react";
import { styled } from "@mui/material/styles";
import Box from "@mui/material/Box";

import Typography from "@mui/material/Typography";

import IconButton from "@mui/material/IconButton";

import {
    Button,
    TextField,
    Container,
    Grid,
    TableHead,
    Table,
    TableBody,
    TableCell,
    TableContainer,
    TableRow,
    tableCellClasses,
    Alert,
    Snackbar,
    LinearProgress,
} from "@mui/material";
import DeleteOutlineOutlinedIcon from "@mui/icons-material/DeleteOutlineOutlined";
import TextSnippetOutlinedIcon from "@mui/icons-material/TextSnippetOutlined";

import axios from "../../../../axiosConfig";
import { route } from "../../../../user-panel/helpers";
import {useInfiniteQuery, useMutation, useQuery} from "react-query";
import { SubmitHandler, useForm } from "react-hook-form";
import { ChangeEvent, useRef, useState } from "react";
import TableSkeleton from "../../../components/TableSkeleton";

const StyledTableCell = styled(TableCell)(({ theme }) => ({
    [`&.${tableCellClasses.head}`]: {
        backgroundColor: "primary.main",
        color: "primary.main",
    },
    [`&.${tableCellClasses.body}`]: {
        fontSize: 14,
    },
}));

const StyledTableRow = styled(TableRow)(({ theme }) => ({
    "&:nth-of-type(odd)": {
        backgroundColor: "#fafafa",
    },
    "&:nth-of-type(even)": {
        backgroundColor: "#EAEEF3",
    },
    "&:last-child td, &:last-child th": {
        border: 0,
    },
}));

type education = {
    id: number;
    title: string;
    level: string;
    university: string;
    from: string;
    to: string;
    status: string;
};

const backgroundColors = (status) => {
    let backgroundColor = "";
    if (status === "Completed") backgroundColor = "primary.30";
    else if (status === "In Progress") backgroundColor = "primary.20";
    else backgroundColor = "orange.30";
    return backgroundColor;
};

export default function AccountInfoEducationalBackground() {
    const [open, setOpen] = React.useState(false);
    const [status, setStatus] = React.useState("success");
    const [message, setMessage] = React.useState("This is a success message!");
    const [disableBtn, setDisableBtn] = React.useState(false);

    const [degree, setDegree] = React.useState("");

    const {
        register,
        handleSubmit,
        setValue,
        reset,
        formState: { errors, isDirty, isValid },
    } = useForm<education>({ mode: "onBlur" });


    // const educationalDetails = useMutation("educationalDetails", async (data) => {
    //             return await axios.get(route("api.web.v1.user-panel.account-info.educational-background.show", { educational_background: data}))
    //     },
    //     {
    //         onSuccess: (data) => {
    //             setOpen(true);
    //             setStatus("success");
    //             setMessage("Send successfully");
    //         },
    //         onError: () => {
    //             setOpen(true);
    //             setStatus("error");
    //             setMessage("Error! Please try later");
    //         },
    //     }
    // );

    const [ education , setEducation] = useState()

    const educationalDetails = useMutation(async (data) => {
        const response = await axios.get(route("api.web.v1.user-panel.account-info.educational-background.show", { "educational_background": data}));
        return response.data;
    }, {
        onSuccess: data => {
            setOpen(true);
            setStatus("success");
            setMessage("Your Data Saved successfully");
            setApiData({
                title : data.data.title,
                university : data.data.university,
                from : data.data.from,
                to : data.data.to,
                level : data.data.level
            })
            window.setTimeout(() => {

            }, 1200);
        }, onError: () => {
            setOpen(true);
            setStatus("error");
            setMessage("Error! Please try later");
        }, onSettled: () => {
        }
    });

    const [ apiData , setApiData ] = useState({
        title : educationalDetails?.data?.data?.title,
        university : educationalDetails?.data?.data?.university,
        from : educationalDetails?.data?.data?.from,
        to : educationalDetails?.data?.data?.to,
        level : educationalDetails?.data?.data?.level
    })

    const educationalRecords = async (pageIndex, pageSize) => {
        const response = await axios.get(
            route(
                "api.web.v1.user-panel.account-info.educational-background.index",
                {},
                pageIndex,
                pageSize
            )
        );
        return response.data;
    };

    const {
        data,
        fetchNextPage,
        hasNextPage,
        isError,
        refetch,
        error,
        isLoading,
    } = useInfiniteQuery(
        "educationalRecords",
        ({ pageParam = 1 }) => educationalRecords(pageParam, 3),
        {
            getNextPageParam: (lastPage) => {
                const { meta } = lastPage;
                if (meta.current_page < meta.last_page) {
                    return meta.current_page + 1;
                }
                return null;
            },
        }
    );

    const deleteEducationalRecords = useMutation(
        "deleteEducationalRecords",
        async (id) => {
            setDisableBtn(true);
            return await axios.delete(route("api.web.v1.user-panel.account-info.educational-background.destroy", { educational_background: id }
                )
            );
        },
        {
            onSuccess: (data) => {
                setDisableBtn(false);
                setOpen(true);
                setStatus("success");
                setMessage("Delete successfully");
                window.setTimeout(() => {
                    refetch().then((r) => "");
                }, 1000);
            },
            onError: () => {
                setDisableBtn(false);
                setOpen(true);
                setStatus("error");
                setMessage("Error! Please try later");
            },
        }
    );

    const postEducationalRecords = useMutation(
        "editEducationalRecords",
        async (data) => {
            if (data.id) {
                return await axios.put(
                    route(
                        "api.web.v1.user-panel.account-info.educational-background.update",
                        { educational_background: data.id }
                    ),
                    data
                ).data;
            } else {
                return await axios.post(
                    route(
                        "api.web.v1.user-panel.account-info.educational-background.store"
                    ),
                    data
                ).data;
            }
        },
        {
            onSuccess: (data) => {
                setOpen(true);
                setStatus("success");
                setMessage("Send successfully");
                window.setTimeout(() => {
                    refetch().then((r) => "");
                }, 1000);
                reset();
            },
            onError: () => {
                setOpen(true);
                setStatus("error");
                setMessage("Error! Please try later");
            },
        }
    );

    function editEducationalRecords(id) {
        let row = [];
        data.pages.map((value, item) => {
            if (value.data.find((row) => row.id === id)) {
                return (row = value.data.find((row) => row.id === id));
            }
        });
        console.log("akbar")
        educationalDetails.mutate(row.id)
        // setValue("id", row.id);
        // setValue("title", row.title);
        // setValue("university", row.university);
        // setValue("level", row.level);
        // setValue("from", row.from);
        // setValue("to", row.to);
    }

    const onSubmit: SubmitHandler<education> = (data) => {
        postEducationalRecords.mutate(data);
    };

    if (educationalRecords.isError) {
        return <p>Error</p>;
    }

    if (educationalRecords.isLoading) {
        return <p>Loading</p>;
    }

    const divRef = useRef();
    const [loading, setLoading] = useState(false);

    function handleScroll() {
        if (data) {
            const { scrollTop, scrollHeight, clientHeight } = divRef.current;
            const scrollEndPosition = scrollHeight - clientHeight;
            if (scrollEndPosition - scrollTop < 1 && hasNextPage) {
                setLoading(true);
                fetchNextPage().then((r) => setLoading(false));
            }
        }
    }

    const year = new Date().getFullYear();

    const [inputText, setInputText] = useState("");

    const handleChange = (e: ChangeEvent<HTMLInputElement>) => {
        setInputText(e.target.value);
    };

    const handleValue =(event,value)=>{
        setApiData(...event.target.value)
    }

    return (
        <>
            <Container>
                <Snackbar
