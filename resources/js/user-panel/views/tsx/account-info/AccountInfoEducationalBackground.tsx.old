                                        id="startYear"
                                        label="Start Year"
                                        variant="outlined"
                                        size="small"
                                        fullWidth
                                        value={inputText}
                                        {...register("from", {
                                            onChange:handleChange,
                                            // validate: validateStartYear,
                                            required: true,
                                            max: year,
                                            minLength: 4,
                                            pattern: /^(19\d\d|20\d\d|21\d\d)$/,
                                        })}
                                    />
                                    {errors.from?.type === "max" && (
                                        <Typography
                                            variant="caption"
                                            color="error"
                                            role="alert"
                                        >
                                            Start Year can't be more than {year}
                                        </Typography>
                                    )}
                                    {errors.from?.type === "required" && (
                                        <Typography
                                            variant="caption"
                                            color="error"
                                            role="alert"
                                        >
                                            Start Year is required
                                        </Typography>
                                    )}
                                    {errors.from?.type === "pattern" && (
                                        <Typography
                                            variant="caption"
                                            color="error"
                                            role="alert"
                                        >
                                            Please enter a valid year
                                        </Typography>
                                    )}
                                    {errors.from?.type === "minLength" && (
                                        <Typography
                                            variant="caption"
                                            color="error"
                                            role="alert"
                                        >
                                            Please enter a 4 digit year
                                        </Typography>
                                    )}
                                </Grid>
                                <Grid item xs={12} md={4} lg={3}>
                                    <TextField
                                        id="endYear"
                                        label="End Year"
                                        variant="outlined"
                                        size="small"
                                        fullWidth
                                        {...register("to", {
                                            // validate: validateEndYear,
                                            max: year,
                                            maxLength: 4,
                                            min: inputText,
                                            pattern: /^(19\d\d|20\d\d|21\d\d)$/,
                                        })}
                                    />
                                    {errors.to?.type === "max" && (
                                        <Typography
                                            variant="caption"
