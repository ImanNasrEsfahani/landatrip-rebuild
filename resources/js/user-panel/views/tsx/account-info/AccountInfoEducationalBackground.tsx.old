                            onSubmit={handleSubmit(onSubmit)}
                            sx={{ mt: 5 }}
                        >
                            {educationalDetails.isSuccess ? (
                                <Grid container spacing={4}>
                                    <Grid item xs={12} md={4} lg={3}>
                                        <TextField
                                            id="field"
                                            label="Field"
                                            variant="outlined"
                                            InputLabelProps={{ shrink: true }}
                                            inputProps={{readOnly : false}}
                                            value={apiData.title}
                                            onClick={(event,value)=> {handleValue(event,value)}}
                                            size="small"
                                            fullWidth
                                            {...register("title", {
                                                required: true,
                                            })}
                                        />
                                        {errors.title?.type === "required" && (
                                            <Typography
                                                variant="caption"
                                                color="error"
                                                role="alert"
                                            >
                                                Field is required
                                            </Typography>
                                        )}
                                    </Grid>
                                    <Grid item xs={12} md={4} lg={3}>
                                        <TextField
                                            id="universityOrCollege"
                                            label="University/College"
                                            variant="outlined"
                                            InputLabelProps={{ shrink: true }}
                                            value={apiData.university}
                                            onClick={(event,value)=> {handleValue(event,value)}}
                                            size="small"
                                            fullWidth
                                            {...register("university", {
                                                required: true,
                                            })}
                                        />
                                        {errors.university?.type === "required" && (
                                            <Typography
                                                variant="caption"
                                                color="error"
                                                role="alert"
                                            >
                                                University is required
                                            </Typography>
                                        )}
                                    </Grid>
                                    <Grid item xs={12} md={4} lg={3}>
                                        <TextField
                                            id="degree"
                                            label="Degree"
                                            variant="outlined"
                                            InputLabelProps={{ shrink: true }}
                                            value={apiData.level}
                                            onClick={(event,value)=> {handleValue(event,value)}}
                                            size="small"
                                            fullWidth
                                            {...register("level", {
                                                required: true,
                                            })}

                                        />
                                        {errors.level?.type === "required" && (
                                            <Typography
                                                variant="caption"
                                                color="error"
                                                role="alert"
                                            >
                                                Degree is required
                                            </Typography>
                                        )}
                                    </Grid>
                                    <Grid item xs={12} md={4} lg={3}>
                                        <TextField
                                            id="startYear"
