                                        variant="outlined"
                                        size="small"
                                        fullWidth
                                        {...register("title", {
                                            required: true,
                                        })}
                                    />
                                    {errors.title?.type === "required" && (
                                        <Typography
                                            variant="caption"
                                            color="error"
                                            role="alert"
                                        >
                                            Field is required
                                        </Typography>
                                    )}
                                </Grid>
                                <Grid item xs={12} md={4} lg={3}>
                                    <TextField
                                        id="universityOrCollege"
                                        label="University/College"
                                        variant="outlined"
                                        size="small"
                                        fullWidth
                                        {...register("university", {
                                            required: true,
                                        })}
                                    />
                                    {errors.university?.type === "required" && (
                                        <Typography
                                            variant="caption"
                                            color="error"
                                            role="alert"
                                        >
                                            University is required
                                        </Typography>
                                    )}
                                </Grid>
                                <Grid item xs={12} md={4} lg={3}>
                                    <TextField
                                        id="degree"
                                        label="Degree"
                                        variant="outlined"
                                        size="small"
                                        fullWidth
                                        {...register("level", {
                                            required: true,
                                        })}

                                    />
                                    {errors.level?.type === "required" && (
                                        <Typography
                                            variant="caption"
                                            color="error"
                                            role="alert"
                                        >
                                            Degree is required
                                        </Typography>
                                    )}
