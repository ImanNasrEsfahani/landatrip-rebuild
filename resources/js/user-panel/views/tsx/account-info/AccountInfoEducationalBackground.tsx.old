                                                            {value.to
                                                                ? value.to
                                                                : "Until Now"}
                                                        </StyledTableCell>
                                                        <StyledTableCell
                                                            sx={{
                                                                borderColor:
                                                                    "primary.main",
                                                            }}
                                                            align="center"
                                                        >
                                                            <Box>
                                                                <Typography
                                                                    sx={{
                                                                        backgroundColor:
                                                                            backgroundColors(
                                                                                value.status
                                                                            ),
                                                                        padding: 0.3,
                                                                        width: "75%",
                                                                        margin: "auto",
                                                                        borderRadius: 10,
                                                                    }}
                                                                    align="center"
                                                                >
                                                                    {
                                                                        value.status
                                                                    }
                                                                </Typography>
                                                            </Box>
                                                        </StyledTableCell>
                                                        <StyledTableCell
                                                            sx={{
                                                                borderColor:
                                                                    "primary.main",
                                                            }}
                                                            align="center"
                                                        >
                                                            <IconButton
                                                                onClick={() =>
                                                                    editEducationalRecords(
                                                                        value.id
                                                                    )
                                                                }
                                                                sx={{
                                                                    color: "primary.main",
                                                                }}
                                                            >
                                                                <TextSnippetOutlinedIcon />
                                                            </IconButton>
                                                            <IconButton
                                                                disabled={
                                                                    disableBtn
                                                                }
                                                                onClick={() =>
                                                                    deleteEducationalRecords.mutate(
                                                                        value.id
                                                                    )
                                                                }
                                                                sx={{
                                                                    color: "orange.main",
                                                                }}
                                                            >
                                                                <DeleteOutlineOutlinedIcon />
                                                            </IconButton>
                                                        </StyledTableCell>
                                                    </StyledTableRow>
                                                ))}
                                            </React.Fragment>
                                        ))
                                    ) : (
                                        <StyledTableRow
                                            sx={{ py: 5, textAlign: "center" }}
                                        >
                                            <StyledTableCell
                                                colSpan={6}
                                                align="center"
                                            >
                                                No Data
                                            </StyledTableCell>
                                        </StyledTableRow>
                                    )}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </Box>
                </Box>
            </Container>
        </>
    );
}
