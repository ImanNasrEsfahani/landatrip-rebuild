                    }}
                    anchorOrigin={{ vertical: "top", horizontal: "right" }}
                >
                    <Alert
                        onClose={() => {
                            setOpen(false);
                        }}
                        severity={status}
                        sx={{ width: "100%" }}
                    >
                        {message}
                    </Alert>
                </Snackbar>
                <Box sx={{ mx: 7.5 }}>
                    <Box
