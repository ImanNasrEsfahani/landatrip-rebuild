                                            size="small"
                                            fullWidth
                                            {...register("to", {
                                                // validate: validateEndYear,
                                                max: year,
                                                maxLength: 4,
                                                min: inputText,
                                                pattern: /^(19\d\d|20\d\d|21\d\d)$/,
                                            })}
                                        />
                                        {errors.to?.type === "max" && (
                                            <Typography
                                                variant="caption"
                                                color="error"
                                                role="alert"
                                            >
                                                End Year can't be more than {year}
                                            </Typography>
                                        )}
                                        {errors.to?.type === "min" && (
                                            <Typography
                                                variant="caption"
                                                color="error"
                                                role="alert"
                                            >
                                                EndYear must be Equal or More than{" "}
                                                {inputText}
                                            </Typography>
                                        )}
                                        {errors.to?.type === "pattern" && (
                                            <Typography
                                                variant="caption"
                                                color="error"
                                                role="alert"
                                            >
                                                Please enter a valid year
                                            </Typography>
                                        )}
                                        {errors.to?.type === "maxLength" && (
                                            <Typography
                                                variant="caption"
                                                color="error"
                                                role="alert"
                                            >
                                                Please enter a 4 digit year
                                            </Typography>
                                        )}
                                    </Grid>
                                </Grid>
                            ):(
                                <Grid container spacing={4}>
                                <Grid item xs={12} md={4} lg={3}>
                                    <TextField
                                        id="field"
